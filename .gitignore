node_modules/
.env
# The library database: it holds your Spotify access and refresh tokens in `auth`
# as well as your entire listening history. This line used to read organify.db*,
# the project's old name, which ignored nothing at all.
mappify.db
mappify.db-shm
mappify.db-wal
# Every user's library and their Spotify tokens, one file each.
data/
.mbdump/
.impeccable/
out/

# Rust build output for the Windows launcher.
launcher/target/

# The 27MB Blue Marble source that tools/build-earth-tiles.mjs slices. The
# tiles it produces are committed; re-downloading the source is one command.
tools/.cache/
