SPOTIFY_CLIENT_ID=
MB_CONTACT=you@example.com

# Where a browser reaches this instance. The Spotify redirect URI is derived
# from it, and must be added *exactly* in your app at developer.spotify.com:
#
#   <MAPPIFY_PUBLIC_URL>/api/auth/callback
#
# Left blank it is http://127.0.0.1:8787, which is right for running it locally.
# Set it to your https:// address when hosting for other people — that also
# turns on the Secure flag for the session cookie.
MAPPIFY_PUBLIC_URL=

# 127.0.0.1 keeps the server reachable only from this machine. A hosted instance
# needs 0.0.0.0, which is a decision to expose it and so is never the default.
MAPPIFY_HOST=

# One SQLite file per signed-in account, plus control.db for sessions.
# Defaults to ./data. Back this up: it is everyone's library and their tokens.
MAPPIFY_DATA=

# Shared origin index (optional but recommended: makes matching instant).
# Create a free database at turso.tech, then:
#   turso db create mappify-index
#   turso db show mappify-index --url
#   turso db tokens create mappify-index
#
# Leave both blank to run with no index at all: matching falls back to the live
# MusicBrainz API, which works and is slow (~2.2s per artist).
#
# A token handed to someone else should be read-only. This file is committed, so
# nothing real belongs below these two lines.
MAPPIFY_INDEX_URL=
MAPPIFY_INDEX_TOKEN=
