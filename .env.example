SPOTIFY_CLIENT_ID=
MB_CONTACT=you@example.com

# Shared origin index (optional but recommended: makes matching instant).
# Create a free database at turso.tech, then:
#   turso db create mappify-index
#   turso db show mappify-index --url
#   turso db tokens create mappify-index
#
# Leave both blank to run with no index at all: matching falls back to the live
# MusicBrainz API, which works and is slow (~2.2s per artist).
#
# A token handed to someone else should be read-only. This file is committed, so
# nothing real belongs below these two lines.
MAPPIFY_INDEX_URL=
MAPPIFY_INDEX_TOKEN=
